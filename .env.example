# Copy to .env and replace this value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Production web port; development uses DEV_PORT and DEV_API_PORT.
PORT=8080
DEV_PORT=5173
DEV_API_PORT=8000
MAX_UPLOAD_BYTES=26214400

# Set to 1 when the production site is served over HTTPS.
COOKIE_SECURE=0

# Production defaults to SQLite in a persistent Docker volume.
# For PostgreSQL, set POSTGRES_PASSWORD and uncomment DATABASE_URL;
# start with: docker compose -p ticketing-prod -f docker-compose.yml --profile postgres up --build -d
# POSTGRES_PASSWORD=replace-with-a-strong-password
# DATABASE_URL=postgresql+psycopg://ticketing:replace-with-a-strong-password@postgres:5432/ticketing

# Or connect to an existing MySQL database:
# DATABASE_URL=mysql+pymysql://ticketing:password@mysql-host:3306/ticketing?charset=utf8mb4
